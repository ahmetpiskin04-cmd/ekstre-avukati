<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Açık tema; v29+ klasöründe sistemin koyu/açık seçimini izleyen DayNight sürümü var.
         WebView, prefers-color-scheme değerini uygulama temasından alır. -->
    <style name="AppTheme" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
